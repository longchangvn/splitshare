{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // NOTE: connection strings are environment-only (never committed here):
  //   Database__Provider   postgres | sqlServer   (default: sqlserver)
  //   Database__Postgres / Database__SqlServer    provider connection string
  // Compose/Container Apps get them from the env-file; local dev uses
  // `dotnet user-secrets set "Database:SqlServer" "..."` (see README).
  "Database": {
    "Provider": "sqlserver"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "http://localhost:3000"]
  },
  "Auth": { "GoogleClientId": "629654657844-qa8bhnse10a2ppdmo678ir32vab63qns.apps.googleusercontent.com" },
  // Email sender (sign-in codes, password reset, verification, invites). Primary: "smtp"
  // (alias "gmail") = Gmail SMTP as noreply.splitshares@gmail.com. Email__Smtp__Password is
  // a Gmail App Password — a secret, env/user-secrets only, never here.
  // "sendgrid" (alias "twilio") = Twilio SendGrid (env Email__Twilio__ApiKey + a
  // SendGrid-verified Email__FromAddress). "onesignal" = OneSignal email channel (reuses
  // Notification:OneSignal:AppId/ApiKey unless Email:OneSignal:* is set). Empty = log only.
  "Email": {
    "Provider": "smtp",
    "FromName": "SplitShare",
    "FromAddress": "noreply.splitshares@gmail.com",
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "EnableSsl": true,
      "Username": "noreply.splitshares@gmail.com"
    }
  },
  // Receipt scan (specs/004). Ocr:ApiKey is a secret: env Ocr__ApiKey or
  // `dotnet user-secrets set "Ocr:ApiKey" "..." --project api` — never here.
  // Default provider is OpenCode Console ("OpenCode Zen") through its OpenAI-compatible
  // surface. Free-tier models reject direct API calls (403 FreeTierError), so the default
  // model is a paid vision model; switch by config only.
  "Ocr": {
    "Enabled": false,
    "Provider": "openai-compatible",
    "BaseUrl": "https://opencode.ai/inference/openai/v1",
    "Model": "glm-5.3-flash",
    "TimeoutSeconds": 30,
    "RateLimit": { "PermitLimit": 20, "WindowMinutes": 10 }
  }
}
