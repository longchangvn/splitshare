POSTGRES_USER=module_platform
POSTGRES_PASSWORD=module_platform
POSTGRES_DB=module_platform
# >=32 chars; required in production (dev falls back to an insecure key)
JWT_KEY=dev-only-insecure-key-change-in-prod-0123456789
# optional: enables Google login button in web build
GOOGLE_CLIENT_ID=
# --- SQL Server instead of Postgres ---
# DB_PROVIDER=sqlServer
# MSSQL_HOST=localhost
# MSSQL_PORT=1433
# MSSQL_DB=splitshare
# MSSQL_USER=sa
# MSSQL_PASSWORD=ChangeMe123!
# (API reads Database__Provider=sqlServer + Database__SqlServer connection string;
#  see api/Migrations/README.md — no code change needed to switch providers.)
