# =============================================================================
# env.remote — remote (tunnel) deployment of web + api via docker compose.
#
# Topology:
#   Browser -> https://rbmp9mvb-3000.use.devtunnels.ms/ (web tunnel -> compose web:80)
#                -> same-origin /api/* -> nginx -> api:8080 (no CORS involved)
#   Browser -> https://rbmp9mvb-8081.use.devtunnels.ms/ (api tunnel, direct API access)
#   API     -> host-side Postgres on port 5342 (NOT the compose `db` service)
#
# Usage:
#   docker compose --env-file .env.remote up --build
#
# Notes:
#   - The compose `db` service still starts (api depends_on it); it is unused
#     when DB_HOST points at the host. Its host port mapping (5433) is kept
#     to avoid clashing with your host Postgres on 5342.
#   - host.docker.internal resolves on Docker Desktop automatically; on Linux
#     the compose `extra_hosts: host-gateway` entry covers it.
#   - Google login additionally needs https://rbmp9mvb-3000.use.devtunnels.ms
#     registered as an authorized JavaScript origin in Google Cloud Console.
#     It cannot be set from here.
# =============================================================================

# --- Frontend origin (must match the browser address bar; used for CORS) ---
WEB_URL=https://rbmp9mvb-3000.use.devtunnels.ms

# --- API ---
ASPNETCORE_ENVIRONMENT=Production
# REQUIRED in Production: >= 32 chars. The dev fallback is rejected at boot.
JWT_KEY=REPLACE_ME_WITH_A_32_PLUS_CHAR_SECRET

# --- Database: host-side Postgres on port 5342 ---
DB_PROVIDER=postgres
DB_HOST=host.docker.internal
DB_PORT=5432
POSTGRES_DB=splitshare
POSTGRES_USER=module_platform
POSTGRES_PASSWORD=module_platform

# --- Web build ---
# NOTE: the SPA calls relative /api/* (proxied by nginx), so this is unused
# at runtime; kept for parity with docker-compose.yml.
VITE_API_URL=https://rbmp9mvb-8081.use.devtunnels.ms
# Optional: enables the Google login button in the web build.
GOOGLE_CLIENT_ID=
