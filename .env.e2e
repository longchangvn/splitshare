# =============================================================================
# .env.e2e — environment for the end-to-end suite. Safe to commit: local test
# database only, no secrets. Loaded by scripts/e2e.sh (`set -a; source .env.e2e`).
#
# Two consumers:
#   1. tests.e2e (WebApplicationFactory) — env vars reach Program.cs; the fixture
#      also derives its admin connection from Database__Postgres to CREATE/DROP
#      the test database before the host boots.
#   2. the browser suite (Playwright) — scripts/e2e.sh starts the real API + Vite
#      with this file, so web tests hit the same stack a developer runs by hand.
# =============================================================================

# --- Test database (dropped + recreated at the start of every API E2E run) ---
E2E_DB=splitshare_e2e
Database__Provider=postgres
Database__Postgres="Host=localhost;Port=5432;Database=splitshare_e2e;Username=module_platform;Password=module_platform"

# --- Auth ---
# >=32 chars (dev fallback is refused in Production; Development would only warn).
Jwt__Key=splitshare-e2e-signing-key-0123456789abcdef0123456789abcdef
# Every E2E request shares one rate-limit partition on localhost; prod default
# stays 5/min, this raises it so a full happy-path run never 429s.
RateLimit__AuthIp__PermitLimit=1000

# --- External side effects: OFF (the API E2E host swaps in fakes anyway) ---
# "" = log-only stub; never reaches Gmail/SendGrid/OneSignal.
Email__Provider=
Notification__Provider=
Ocr__Enabled=false
Ocr__ApiKey=

# --- Paths / origins ---
Uploads__Path=.tmp/e2e-uploads
App__BaseUrl=http://localhost:3000
Cors__AllowedOrigins__0=http://localhost:3000

# --- Process / dev-server wiring (Playwright webServer) ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:8081
VITE_API_URL=http://localhost:8081
WEB_URL=http://localhost:3000
